# Configure these in the selected Convex deployment, not in the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Opt in only for a development deployment; fixtures are explicitly simulated.
ENABLE_DEV_FIXTURES=false
# Convex dev writes deployment selection to the ignored .env.local.
# Orbital service (services/orbit). Unset = no computed maneuver candidates.
ORBIT_SERVICE_URL=
ORBIT_SERVICE_TOKEN=
