# OrbitCall HTTPS entry point. See deploy/README.md.
# ORBITCALL_API_HOST must be a hostname the team controls, with an A record to the Droplet,
# so Caddy can obtain its certificate. Caddy does not authenticate callers: the orbit
# service checks ORBIT_SERVICE_TOKEN on every route except /health. The scheduler checks
# its separate Bearer SCHEDULE_SERVICE_TOKEN on every route, including /health.

{$ORBITCALL_API_HOST} {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Service-Token delete
				request>headers>Authorization delete
			}
		}
	}

	handle /orbit/health {
		rewrite * /health
		reverse_proxy orbit:3610
	}

	handle_path /orbit/* {
		reverse_proxy orbit:3610
	}

	handle_path /scheduler/* {
		reverse_proxy scheduler:8090
	}

	handle {
		respond 404
	}
}
